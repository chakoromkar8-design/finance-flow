# Backend settings. Copy this file to ".env" (same folder as package.json) and fill it in.
# NEVER commit the real .env file.

# PostgreSQL connection string. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/financeflow?schema=public"

# Secret used to sign login tokens. Must be long and random (32+ characters).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Port the API listens on
PORT=3001

# Address of the frontend (used for CORS + cookie safety). Comma-separate several.
FRONTEND_URL=http://localhost:5173

# development | production
NODE_ENV=development

# Optional
# SESSION_DAYS=7                 # how long a login lasts
# COOKIE_SAMESITE=lax            # "none" is needed if frontend and API are on different domains in production
# TZ_OFFSET_MINUTES=330          # so "this month" follows India time (UTC+5:30)
# DEMO_PASSWORD=Demo12345        # only used by `npm run db:seed`
