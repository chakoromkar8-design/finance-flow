// FinanceFlow database schema (PostgreSQL via Prisma).
// Money uses Decimal(14,2) (exact, no floating point drift). Dates that are
// "calendar days" (transaction date, EMI due date...) use @db.Date.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  SAVINGS
  CURRENT
  CASH
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum EmiStatus {
  PENDING
  PAID
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]
  loans        Loan[]
  emis         Emi[]
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  institution    String?
  // Balance at the moment the account was added. The live balance is
  // computed as openingBalance + income - expenses (see server/services/balances.js).
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  accountId   String
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  category    String
  description String
  notes       String?
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: an account that still has transactions cannot be deleted by accident.
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, category])
  @@index([accountId])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  // Monthly limit. "Spent" is NOT stored: it is computed from transactions.
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model Goal {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  targetAmount        Decimal   @db.Decimal(14, 2)
  currentAmount       Decimal   @default(0) @db.Decimal(14, 2)
  monthlyContribution Decimal   @default(0) @db.Decimal(14, 2)
  deadline            DateTime? @db.Date
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Loan {
  id                String     @id @default(cuid())
  userId            String
  name              String
  principalAmount   Decimal    @db.Decimal(14, 2)
  outstandingAmount Decimal    @db.Decimal(14, 2)
  interestRate      Decimal    @db.Decimal(5, 2) // annual %, e.g. 8.50
  emiAmount         Decimal    @db.Decimal(14, 2)
  startDate         DateTime   @db.Date
  endDate           DateTime?  @db.Date
  status            LoanStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  emis Emi[]

  @@index([userId])
}

model Emi {
  id            String    @id @default(cuid())
  userId        String
  loanId        String
  amount        Decimal   @db.Decimal(14, 2)
  dueDate       DateTime  @db.Date
  status        EmiStatus @default(PENDING)
  paidDate      DateTime? @db.Date
  // How much of this EMI reduced the loan principal when it was marked paid
  // (kept so un-paying restores the exact outstanding amount).
  principalPaid Decimal?  @db.Decimal(14, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([loanId])
}
