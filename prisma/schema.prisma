// FinanceFlow database schema (PostgreSQL via Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  SAVINGS
  CURRENT
  CASH
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum EmiStatus {
  PENDING
  PAID
}

enum InvestmentType {
  SHARES
  MUTUAL_FUND
  SIP
  BOND
  FD
  COMMODITY
  LIC
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  MATURED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]
  loans        Loan[]
  emis         Emi[]
  investments  Investment[]
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  institution    String?
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  accountId       String
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  category        String
  description     String
  notes           String?
  date            DateTime        @db.Date
  includeInBudget Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, category])
  @@index([accountId])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model Goal {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  targetAmount        Decimal   @db.Decimal(14, 2)
  currentAmount       Decimal   @default(0) @db.Decimal(14, 2)
  monthlyContribution Decimal   @default(0) @db.Decimal(14, 2)
  deadline            DateTime? @db.Date
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Loan {
  id                String     @id @default(cuid())
  userId            String
  name              String
  principalAmount   Decimal    @db.Decimal(14, 2)
  outstandingAmount Decimal    @db.Decimal(14, 2)
  interestRate      Decimal    @db.Decimal(5, 2)
  emiAmount         Decimal    @db.Decimal(14, 2)
  startDate         DateTime   @db.Date
  endDate           DateTime?  @db.Date
  status            LoanStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  emis Emi[]

  @@index([userId])
}

model Emi {
  id            String    @id @default(cuid())
  userId        String
  loanId        String
  amount        Decimal   @db.Decimal(14, 2)
  dueDate       DateTime  @db.Date
  status        EmiStatus @default(PENDING)
  paidDate      DateTime? @db.Date
  principalPaid Decimal?  @db.Decimal(14, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([loanId])
}

model Investment {
  id     String           @id @default(cuid())
  userId String
  type   InvestmentType
  name   String
  status InvestmentStatus @default(ACTIVE)

  institution  String?
  symbol       String?
  policyNumber String?

  investedAmount Decimal @default(0) @db.Decimal(14, 2)
  currentValue   Decimal @default(0) @db.Decimal(14, 2)

  quantity      Decimal? @db.Decimal(18, 6)
  purchasePrice Decimal? @db.Decimal(14, 4)
  currentPrice  Decimal? @db.Decimal(14, 4)
  units         Decimal? @db.Decimal(18, 6)
  purchaseNav   Decimal? @db.Decimal(14, 4)
  currentNav    Decimal? @db.Decimal(14, 4)

  monthlyAmount   Decimal?  @db.Decimal(14, 2)
  startDate       DateTime? @db.Date
  nextPaymentDate DateTime? @db.Date

  interestRate Decimal?  @db.Decimal(5, 2)
  maturityDate DateTime? @db.Date

  premiumAmount    Decimal?  @db.Decimal(14, 2)
  premiumFrequency String?
  nextPremiumDate  DateTime? @db.Date

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, status])
}
